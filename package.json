{
  "name": "@shaoshi/dshscan",
  "version": "0.2.0",
  "description": "DShScan - DSH plugin security scanner inspired by NVIDIA SkillSpector",
  "type": "module",
  "bin": {
    "dshscan": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "dshscan",
    "dshscan.cmd"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "scan": "tsx src/main.ts",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "security",
    "scanner",
    "plugin",
    "skillspectator",
    "supply-chain",
    "ai-security"
  ],
  "license": "MIT",
