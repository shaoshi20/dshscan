  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaoshi20/dshscan.git"
  },
  "bugs": {
    "url": "https://github.com/shaoshi20/dshscan/issues"
  },
  "homepage": "https://github.com/shaoshi20/dshscan#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
