{
  "name": "@shaoshi/dshscan",
  "version": "0.2.2",
  "description": "DShScan - DSH plugin security scanner inspired by NVIDIA SkillSpector",
  "type": "module",
  "bin": {
    "dshscan": "dist/main.js"
  },
  "main": "dsh-plugin/index.mjs",
  "exports": {
    ".": "./dsh-plugin/index.mjs",
    "./cli": "./dist/main.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "dsh-plugin/",
    "cordis.patch.yml",
    "src/",
    "README.md",
    "LICENSE",
    "dshscan",
    "dshscan.cmd"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "scan": "tsx src/main.ts",
    "test": "tsx --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "dsh",
    "security",
    "scanner",
    "plugin",
    "skillspectator",
    "supply-chain",
    "ai-security"
  ],
  "license": "MIT",
  "author": "shaoshi20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaoshi20/dshscan.git"
  },
  "bugs": {
    "url": "https://github.com/shaoshi20/dshscan/issues"
  },
  "homepage": "https://github.com/shaoshi20/dshscan#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
